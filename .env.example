# Copy to .env.local and fill in your own values. Never commit real secrets.
PORT=5000
URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
STRIPE_SECRET_KEY=sk_test_replace_with_your_own_key
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
# Comma-separated admin emails (auto-promoted to role=admin at login)
ADMIN_EMAILS=you@example.com
# Instructor share of each sale, e.g. 0.7 = 70% instructor / 30% platform
INSTRUCTOR_SHARE=0.7
